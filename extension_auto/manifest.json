{
  "manifest_version": 3,
  "name": "Sunwin TLMN Hook",
  "short_name": "SW TLMN",
  "version": "3.9.0",
  "description": "Đọc bài TLMN Sunwin — Connect góc trái dưới tới Python Control",
  "permissions": ["tabs"],
  "host_permissions": [
    "*://*.sunwin.works/*",
    "*://*.sunwin.club/*",
    "*://*.web-sunwin.pw/*",
    "*://web-sunwin.pw/*",
    "*://*.sunwin.pw/*",
    "*://sunwin.pw/*",
    "*://web.sunwin.villas/*",
    "*://*.sunwin.villas/*",
    "http://127.0.0.1:17831/*"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sunwin TLMN Hook",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.sunwin.works/*",
        "*://*.sunwin.club/*",
        "*://*.web-sunwin.pw/*",
        "*://web-sunwin.pw/*",
        "*://*.sunwin.pw/*",
        "*://sunwin.pw/*",
        "*://web.sunwin.villas/*",
        "*://*.sunwin.villas/*"
      ],
      "js": ["sniffer.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.sunwin.works/*",
        "*://*.sunwin.club/*",
        "*://*.web-sunwin.pw/*",
        "*://web-sunwin.pw/*",
        "*://*.sunwin.pw/*",
        "*://sunwin.pw/*",
        "*://web.sunwin.villas/*",
        "*://*.sunwin.villas/*"
      ],
      "js": ["isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
